{
  "dateFilter": {
    "enabled": true
  },
  "logo": {
    "width": 100,
    "height": 100,
    "file": "asset/logo.svg",
    "fallbackText": "LOGO"
  },
  "menu": {
    "width": 435,
    "height": 720,
    "padding": "16px 20px",
    "borderRadius": "0px"
  },
  "export": {
    "format": "png",
    "deviceScaleFactor": 2,
    "fullPage": true,
    "omitBackground": false
  },
  "output": {
    "directory": "output",
    "htmlDebug": true
  },
  "texts": {
    "hours": "Cucina aperta 12:00-14:00",
    "cta": "LINK IN BIO PER LA PRENOTAZIONE",
    "sections": {
      "primi": "Primi Piatti",
      "secondi": "Secondo",
      "piatti_healthy": "Piatto Healthy"
    }
  },
  "placeholders": {
    "hours": "[HOURS]",
    "date": "[DATA]",
    "cta": "[CTA]",
    "sections": {
      "primi": "[SECTION_PRIMI]",
      "secondi": "[SECTION_SECONDI]",
      "piatti_healthy": "[SECTION_PIATTI_HEALTHY]"
    }
  },
  "colors": {
    "background": "linear-gradient(135deg, #6B9AB8 0%, #8BB4CC 50%, #E8D5C4 100%)",
    "text": "white",
    "cta_bg": "#FFD700",
    "cta_text": "#333",
    "section_border": "rgba(255,255,255,0.3)",
    "footer_border": "rgba(255,255,255,0.3)"
  },
  "fonts": {
    "main": "'ITC Avant Garde Gothic Std', 'Century Gothic', 'Avant Garde', sans-serif",
    "fallback": "'Century Gothic', sans-serif"
  },
  "typography": {
    "subtitle": {
      "fontSize": "14px",
      "letterSpacing": "3px",
      "fontWeight": "700"
    },
    "date": {
      "fontSize": "20px",
      "fontWeight": "700"
    },
    "hours": {
      "fontSize": "12px",
      "fontStyle": "italic"
    },
    "sectionTitle": {
      "fontSize": "15px",
      "fontWeight": "700",
      "letterSpacing": "1.5px",
      "textTransform": "uppercase"
    },
    "dishItem": {
      "fontSize": "12.5px",
      "lineHeight": "1.5",
      "fontWeight": "400"
    },
    "cta": {
      "fontSize": "13px",
      "fontWeight": "700",
      "letterSpacing": "1px"
    }
  },
  "spacing": {
    "headerMarginBottom": "12px",
    "logoMarginBottom": "6px",
    "dateMargin": "8px 0 6px 0",
    "hoursMarginBottom": "14px",
    "sectionMarginBottom": "14px",
    "sectionTitleMarginBottom": "8px",
    "dishItemMarginBottom": "5px",
    "footerPaddingTop": "14px"
  }
}